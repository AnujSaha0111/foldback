# Template for ~/foldback/.env on the Mac mini. Names only: never put a real value in this file.
# Create the real file with `umask 077`, so it is mode 600, and generate secrets on the Mac itself.
# Never paste a value into chat, an issue, or a screenshot.

# Image to run. `latest` is the newest main. Pin a `sha-<full commit>` tag here to stay on one build.
BACKEND_TAG=latest

# Database passwords. Hex only, so they are safe inside connection URLs: openssl rand -hex 24
# POSTGRES_PASSWORD is the owner role (migrations, housekeeping, backups). The backend never receives it.
POSTGRES_PASSWORD=
# APP_DB_PASSWORD is foldback_app, the DML-only role the backend connects as. Read on the first start only.
APP_DB_PASSWORD=

# Session signing key, at least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Optional bearer token for /metrics: openssl rand -hex 24
METRICS_TOKEN=

# The frontend origin, from Nishit once the domain is live, for example https://app.<domain>.
# Comma separated. Also the allow-list for the Origin check.
CORS_ORIGINS=
APP_BASE_URL=
# Parent domain with a leading dot, so app. and api. share the session cookie, for example .<domain>
COOKIE_DOMAIN=

LOG_LEVEL=info

# Kill switches and caps.
SIGNUPS_ENABLED=true
AI_ENABLED=true
AI_DAILY_CALLS=600
# Optional limits (defaults shown). Attempts per minute for everyone, then per signed-in user and per IP.
# AI_GLOBAL_PER_MIN=12
# AI_USER_PER_MIN=6
# AI_USER_PER_DAY=30
# AI_IP_PER_MIN=10
# AI_IP_PER_DAY=60
# Optional. Keys the IP hash stored with each AI call. Falls back to JWT_SECRET when unset.
# IP_HASH_SALT=

# Free LLM keys (phase 4). Leave empty to skip a provider. Shared through a password manager.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Prepaid, not free: the balance on the DeepSeek account is the spend cap. Leave empty to keep the chain free.
DEEPSEEK_API_KEY=

# Sandbox REST app. Without these, checkout stays closed and no PayPal call is made.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Kill switch for checkout and authorize.
PAYPAL_WRITES_ENABLED=true
# Optional (default shown). A call that takes longer counts as unknown.
# PAYPAL_TIMEOUT_MS=15000

# Public API address, used by the deploy check's smoke test, for example https://api.<domain>.
# Leave empty to smoke-test http://127.0.0.1:8787 instead.
PUBLIC_API_URL=

# Backups. BACKUP_DIR defaults to ~/foldback/backups (the Mac's internal disk). An external disk would be /Volumes/<name>/foldback.
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
# Optional off-site copy: a folder that a cloud drive syncs. Copies there are encrypted with the passphrase
# in BACKUP_PASSPHRASE_FILE (a mode 600 file on the Mac, also kept in the password manager).
OFFSITE_DIR=
BACKUP_PASSPHRASE_FILE=
