<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily housekeeping (old ai_usage rows) at 04:15 Mac time. Install: see deploy.md, launchd jobs. Runs as the foldback user. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.foldback.housekeeping</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/foldback/foldback/scripts/housekeeping.sh</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>/Users/foldback/Library/Logs/foldback-housekeeping.log</string>
  <key>StandardErrorPath</key><string>/Users/foldback/Library/Logs/foldback-housekeeping.log</string>
</dict>
</plist>
