# Runs from the repository root. For each package with staged files: Prettier and ESLint on those files, then the
# whole package must typecheck.
check() {
  dir="$1"
  if git diff --cached --name-only --diff-filter=ACMR | grep -q "^$dir/"; then
    (cd "$dir" && corepack yarn lint-staged && corepack yarn typecheck) || exit 1
  fi
}
check backend
check frontend
# gitleaks is optional locally (CI always runs it).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner || exit 1
else
  echo "gitleaks is not installed, skipping the local secret scan (CI runs it)."
fi
