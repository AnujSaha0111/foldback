# The database is a separate service. The app connects as foldback_app (DML only).
# deploy/compose.dev.yml starts a local Postgres 16 on 5432 and creates that role.
DATABASE_URL=postgres://foldback_app:foldback_app@localhost:5432/foldback

# Migrations and housekeeping run as the owner of the tables. Never give this URL to the running app.
MIGRATE_DATABASE_URL=postgres://foldback:foldback@localhost:5432/foldback

# Throwaway database for tests (owner). The tests create foldback_app themselves, then drop and rebuild the schema.
TEST_DATABASE_URL=postgres://foldback:foldback@localhost:5433/foldback_test

# Server
NODE_ENV=development
PORT=8787
# At least 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Comma separated. Also the allow-list for the Origin check.
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Production only: the parent domain for the session cookie, so app. and api. share it (for example .example.com).
COOKIE_DOMAIN=
# Number of proxy hops in front of the app (1 behind Caddy, 0 locally).
TRUST_PROXY=0
LOG_LEVEL=info
# Set GIT_SHA in CI. It appears in /api/health.
GIT_SHA=dev

# Sandbox only. Any other value stops the server at boot.
PAYPAL_ENV=sandbox

# Kill switches
SIGNUPS_ENABLED=true
AI_ENABLED=true
AI_DAILY_CALLS=600
# Optional limits (defaults shown). Attempts per minute for everyone, then per signed-in user and per IP.
# AI_GLOBAL_PER_MIN=12
# AI_USER_PER_MIN=6
# AI_USER_PER_DAY=30
# AI_IP_PER_MIN=10
# AI_IP_PER_DAY=60
# Optional. Keys the IP hash stored with each AI call. Falls back to JWT_SECRET when unset.
# IP_HASH_SALT=

# Free LLM keys (phase 4). Leave empty to skip a provider.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Prepaid, not free: the balance on the DeepSeek account is the spend cap. Leave empty to keep the chain free.
DEEPSEEK_API_KEY=
