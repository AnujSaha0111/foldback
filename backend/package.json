{
  "name": "foldback-backend",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "dup": "jscpd",
    "test": "node --env-file-if-exists=.env ./node_modules/jest/bin/jest.js --runInBand",
    "sync-types": "tsx scripts/sync-types.ts",
    "bakeoff": "tsx --env-file-if-exists=.env scripts/bakeoff.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "hooks": "cd .. && husky backend/.husky",
    "housekeeping": "tsx --env-file-if-exists=.env src/cli/housekeeping.ts",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts migrate",
    "migrate:status": "tsx --env-file-if-exists=.env src/cli/migrate.ts status",
    "migrate:reset": "tsx --env-file-if-exists=.env src/cli/migrate.ts reset"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "husky": "^9.1.7",
    "jest": "^30",
    "jscpd": "^5.4.2",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{json,md,yml,mjs,cjs}": "prettier --write"
  }
}
