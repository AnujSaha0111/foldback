{
  "name": "foldback-backend",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env ./node_modules/jest/bin/jest.js --runInBand",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts migrate",
    "migrate:status": "tsx --env-file-if-exists=.env scripts/migrate.ts status",
    "migrate:reset": "tsx --env-file-if-exists=.env scripts/migrate.ts reset"
  },
  "dependencies": {
    "express": "^5",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "winston": "^3.19.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "jest": "^30",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1"
  }
}
